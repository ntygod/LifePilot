{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.all-hands.dev)",
      "WebFetch(domain:lobehub.com)",
      "WebFetch(domain:docs.openclaw.ai)",
      "Skill(update-config)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"cd $CLAUDE_PROJECT_DIR && changed=$(git diff --name-only 2>/dev/null); if echo \\\"$changed\\\" | grep -q '\\.java$'; then mvn compile -q -DskipTests 2>&1 | tail -20; fi\"",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}

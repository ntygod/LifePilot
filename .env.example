# ============================================================
# ZhiWei（知微）环境变量配置模板
# 使用方法：复制本文件为 .env，填入实际值后执行 docker compose up -d
# ============================================================

# ---- LLM 服务商 API Key（至少配置一个，否则对话功能不可用）----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# ---- 可选：搜索和 Reranker ----
SEARCH_API_KEY=
RERANKER_API_KEY=

# ---- 端口配置（可选，默认值如下）----
# 后端 API 端口
ZHIWEI_PORT=8080
# 前端 Web UI 端口
ZHIWEI_WEB_PORT=80

# ---- 消息渠道凭证（可选，也可通过 Web UI 设置页面配置）----
# 飞书
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 企业微信
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# 钉钉
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=

# ============================================================
# ZhiWei（知微）环境变量配置模板
# 使用方法：复制本文件为 .env，填入实际值后执行 docker compose up -d
# ============================================================

# ---- LLM 服务商 API Key（至少配置一个，否则对话功能不可用）----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# ---- 可选：搜索和 Reranker ----
SEARCH_API_KEY=
RERANKER_API_KEY=

# ---- 端口配置（可选，默认值如下）----
# 后端 API 端口
ZHIWEI_PORT=8080
# 前端 Web UI 端口
ZHIWEI_WEB_PORT=80
